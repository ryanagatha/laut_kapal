# Salin ke .env.local lalu isi nilainya. Berkas .env* tidak pernah di-commit.

# Koneksi PostgreSQL ke basis data pipeline priority-laut.
PRIORITY_LAUT_DSN=postgresql://pengguna:sandi@host:5432/nama_basis_data

# Schema pipeline. Aplikasi hanya MEMBACA schema ini.
PRIORITY_LAUT_SCHEMA=pl

# Style vektor MapTiler. Kosongkan untuk memakai raster OpenStreetMap.
#
# Key MapTiler dibatasi per-domain dari dashboard MapTiler. Bila domain yang
# dipakai belum terdaftar, aplikasi otomatis jatuh ke OSM dan mengatakannya di
# layar — peta tetap tampil, tetapi angka di petak hilang karena raster tidak
# menyediakan glyphs. Daftarkan domainnya kalau angka itu dibutuhkan.
NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/ocean-v4/style.json?key=KEY_ANDA
